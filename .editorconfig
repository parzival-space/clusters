root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{*.yaml,*.yml}]
indent_size = 2

[*.nix]
indent_size = 2

[*.md]
ij_markdown_wrap_text_if_long = true
ij_markdown_format_tables = true
trim_trailing_whitespace = false