{
    "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
    "extends": ["config:recommended"],
    "nix": {
        "enabled": true
    },
    "kubernetes": {
        "enabled": true,
        "managerFilePatterns": [
            "/\\w+\\/deployment\\/.*.yaml/"
        ]
    },
    "flux": {
        "enabled": true,
        "managerFilePatterns": [
            "/(?:^|/)gotk-components\\.ya?ml$/",
            "/\\w+\\/deployment\\/.*.yaml/"
        ]
    },
    "packageRules": [
        {
            "matchManagers": ["kubernetes", "flux"],
            "matchPackageNames": ["/ghcr\\.io\\/parzival-space\\/sxmf-minecraft\\/.*/"],
            "enabled": false
        }
    ]
}
